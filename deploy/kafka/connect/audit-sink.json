{
  "name": "iceberg-audit-sink",
  "config": {
    "connector.class": "io.tabular.iceberg.connect.IcebergSinkConnector",
    "tasks.max": "2",
    "topics": "credential.audit",
    "iceberg.catalog.type": "REST",
    "iceberg.catalog.uri": "http://polaris:8181/api/catalog",
    "iceberg.catalog.credential": "trino-svc:${env:POLARIS_TRINO_SECRET}",
    "iceberg.catalog.warehouse": "kyc-lakehouse",
    "iceberg.tables.auto-create": "true",
    "iceberg.tables.evolve-schema": "true",
    "iceberg.tables.default-partition-by": "audit_date",
    "iceberg.tables.table-prefix": "credential_",
    "iceberg.tables.upsert-mode": "merge-on-read",
    "iceberg.tables.delete-enabled": "false",
    "iceberg.tables.merge-mode": "merge",
    "iceberg.tables.merge-match-keys": "audit_id",
    "iceberg.file-writer.format": "parquet",
    "iceberg.file-writer.compression-codec": "zstd",
    "iceberg.file-writer.target-file-size-bytes": "67108864",
    "iceberg.kafka.commit.interval-ms": "60000",
    "iceberg.kafka.poll.timeout-ms": "5000",
    "iceberg.kafka.max-poll-records": "200",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "audit-sink-dlq",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.retry.timeout": "600000",
    "errors.retry.delay.max.ms": "60000",
    "transforms": "InsertField",
    "transforms.InsertField.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.InsertField.ingested_at.field": "ingested_at",
    "transforms.InsertField.ingested_at.type": "timestamp",
    "transforms.InsertField.source.field": "source",
    "transforms.InsertField.source.static": "kafka-connect-audit-sink"
  }
}
