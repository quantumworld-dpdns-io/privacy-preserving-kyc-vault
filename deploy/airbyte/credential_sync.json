{
  "name": "Credential Data Replication",
  "sourceId": "credential-source-postgres",
  "destinationId": "iceberg-destination-polaris",
  "workspaceId": "kyc-data-lake",
  "catalog": {
    "streams": [
      {
        "stream": {
          "name": "credential_issuances",
          "namespace": "kyc_vault",
          "jsonSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "credential_id": { "type": "string" },
              "credential_type": { "type": "string" },
              "did": { "type": "string" },
              "issuer_did": { "type": "string" },
              "jurisdiction": { "type": "string" },
              "issuance_date": { "type": "string", "format": "date-time" },
              "expiration_date": { "type": "string", "format": "date-time" },
              "risk_score": { "type": "number" },
              "metadata": { "type": "object" },
              "created_at": { "type": "string", "format": "date-time" }
            },
            "required": ["credential_id", "did", "issuer_did"]
          },
          "supportedSyncModes": ["incremental", "full_refresh"],
          "sourceDefinedCursor": true,
          "defaultCursorField": ["created_at"],
          "sourceDefinedPrimaryKey": [["credential_id"]]
        },
        "syncMode": "incremental",
        "destinationSyncMode": "append_dedup",
        "cursorField": ["created_at"],
        "primaryKey": [["credential_id"]]
      },
      {
        "stream": {
          "name": "verification_sessions",
          "namespace": "kyc_vault",
          "jsonSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "session_id": { "type": "string" },
              "applicant_did": { "type": "string" },
              "credential_type": { "type": "string" },
              "verification_result": { "type": "string" },
              "risk_score": { "type": "number" },
              "confidence_score": { "type": "number" },
              "processing_time_ms": { "type": "integer" },
              "workflow_version": { "type": "string" },
              "tenant_id": { "type": "string" },
              "created_at": { "type": "string", "format": "date-time" }
            },
            "required": ["session_id", "applicant_did"]
          },
          "supportedSyncModes": ["incremental", "full_refresh"],
          "sourceDefinedCursor": true,
          "defaultCursorField": ["created_at"],
          "sourceDefinedPrimaryKey": [["session_id"]]
        },
        "syncMode": "incremental",
        "destinationSyncMode": "append_dedup",
        "cursorField": ["created_at"],
        "primaryKey": [["session_id"]]
      },
      {
        "stream": {
          "name": "platform_billing",
          "namespace": "kyc_vault",
          "jsonSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "customer_id": { "type": "string" },
              "tier": { "type": "string" },
              "usage_date": { "type": "string", "format": "date" },
              "api_calls": { "type": "integer" },
              "verifications": { "type": "integer" },
              "revenue_usd": { "type": "number" },
              "fraud_detections": { "type": "integer" }
            },
            "required": ["customer_id", "usage_date"]
          },
          "supportedSyncModes": ["incremental", "full_refresh"],
          "sourceDefinedCursor": true,
          "defaultCursorField": ["usage_date"],
          "sourceDefinedPrimaryKey": [["customer_id", "usage_date"]]
        },
        "syncMode": "incremental",
        "destinationSyncMode": "append_dedup",
        "cursorField": ["usage_date"],
        "primaryKey": [["customer_id", "usage_date"]]
      }
    ]
  },
  "schedule": {
    "scheduleType": "cron",
    "cronExpression": "0 */6 * * * ?",
    "scheduleTimzone": "UTC"
  },
  "resourceRequirements": {
    "cpu_request": "1.0",
    "cpu_limit": "2.0",
    "memory_request": "2Gi",
    "memory_limit": "4Gi"
  }
}
