package kyc-vault:credential;

interface credential-types {
  /// The credential status
  enum credential-status-type {
    active,
    revoked,
    suspended,
    expired,
    pending,
  }

  /// A proof associated with a credential
  record proof {
    proof-type: string,
    created: string,
    verification-method: string,
    proof-purpose: string,
    jws: option<string>,
    proof-value: option<string>,
    nonce: option<string>,
    domain: option<string>,
  }

  /// A credential subject with claims
  record credential-subject {
    id: string,
    claims: list<tuple<string, string>>,
  }

  /// A W3C Verifiable Credential
  record verifiable-credential {
    context: list<string>,
    id: string,
    credential-type: list<string>,
    issuer: string,
    issuance-date: string,
    expiration-date: option<string>,
    credential-subject: credential-subject,
    credential-status: option<credential-status>,
    proof: option<proof>,
  }

  /// Credential revocation/status information
  record credential-status {
    id: string,
    status-type: string,
    revocation-list-index: option<u64>,
    revocation-list-credential: option<string>,
  }

  /// Result of credential verification
  record verification-result {
    verified: bool,
    credential-id: string,
    checks: list<check-result>,
    timestamp: string,
  }

  /// Individual check result
  record check-result {
    name: string,
    passed: bool,
    detail: string,
  }

  /// Schema validation request
  record schema-validation-request {
    credential: verifiable-credential,
    schema-url: option<string>,
  }

  /// Hash of credential data
  record credential-hash {
    algorithm: string,
    value: list<u8>,
  }
}

interface credential-issuance {
  use credential-types.{verifiable-credential, credential-subject, proof};

  /// Issue a new verifiable credential
  issue-credential: func(
    subject: credential-subject,
    issuer: string,
    credential-type: list<string>
  ) -> result<verifiable-credential, string>;

  /// Add a proof to a credential
  add-proof: func(
    credential: verifiable-credential,
    proof: proof
  ) -> verifiable-credential;

  /// Set credential expiration
  set-expiration: func(
    credential: verifiable-credential,
    expiration: string
  ) -> verifiable-credential;
}

interface credential-verification {
  use credential-types.{verifiable-credential, verification-result, credential-hash, check-result};

  /// Verify a credential's integrity and proof
  verify-credential: func(
    credential: verifiable-credential
  ) -> verification-result;

  /// Compute the hash of credential data
  hash-credential: func(
    credential: verifiable-credential,
    algorithm: string
  ) -> credential-hash;

  /// Verify a credential hash
  verify-hash: func(
    data: list<u8>,
    expected-hash: list<u8>,
    algorithm: string
  ) -> bool;

  /// Verify a credential proof (signature)
  verify-proof: func(
    data: list<u8>,
    signature: list<u8>,
    public-key: list<u8>,
    proof-type: string
  ) -> result<bool, string>;
}

interface credential-schema {
  use credential-types.{verifiable-credential, schema-validation-request};

  /// Validate a credential against a JSON schema
  validate-against-schema: func(
    request: schema-validation-request
  ) -> result<verification-result, string>;

  /// Check if a credential conforms to W3C standard
  validate-w3c-conformance: func(
    credential: verifiable-credential
  ) -> result<verification-result, string>;
}

world credential-world {
  import credential-issuance;
  import credential-verification;
  import credential-schema;
  export credential-issuance;
  export credential-verification;
}
