    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6",
    "jest": "^29.6.1",
    "@types/jest": "^29.5.3",
    "ts-jest": "^29.1.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
