# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Connection
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Plaid
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox

# Jumio
JUMIO_API_TOKEN=your_jumio_api_token_here
JUMIO_API_SECRET=your_jumio_api_secret_here

# Onfido
ONFIDO_API_TOKEN=your_onfido_api_token_here

# Credit Bureaus
EXPERIAN_CLIENT_ID=your_experian_client_id_here
EXPERIAN_CLIENT_SECRET=your_experian_client_secret_here
EQUIFAX_CLIENT_ID=your_equifax_client_id_here
EQUIFAX_CLIENT_SECRET=your_equifax_client_secret_here

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# Email Services
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_sendgrid_from_email_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_aws_s3_bucket_name_here

# Web3 Providers
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_project_id
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your_infura_project_id
BSC_RPC_URL=https://bsc-dataseed.binance.org/
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
INFURA_PROJECT_ID=your_infura_project_id_here

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
FACEBOOK_CLIENT_ID=your_facebook_client_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here
APPLE_CLIENT_ID=your_apple_client_id_here
APPLE_CLIENT_SECRET=your_apple_client_secret_here