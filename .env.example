# Core
NODE_ENV=development
LOG_LEVEL=debug

# Server
API_PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://kyc:kyc@localhost:5432/kyc_vault
REDIS_URL=redis://localhost:6379

# DID
DID_METHODS=key,web,ethr
DID_RESOLVER_CACHE_TTL=300

# ZKP
ZKP_PROVING_MODE=local
ZKP_MAX_PROOF_SIZE=1048576
NOIR_PROJECT_DIR=./circuits/noir
RISC0_BONSAI_API_URL=

# Post-Quantum
PQC_ENABLED=true
PQC_DEFAULT_KEM=ml-kem-768
PQC_DEFAULT_SIG=mldsa-87

# Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kyc-credentials
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI
OLLAMA_BASE_URL=http://localhost:11434
AI_DOCUMENT_MODEL=llama3.2-vision
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector DB
VECTOR_DB_PROVIDER=weaviate
WEAVIATE_URL=http://localhost:8080
QDRANT_URL=http://localhost:6333

# MCP
MCP_TRANSPORT=stdio
MCP_SERVER_PORT=3100

# TEE
TEE_PROVIDER=sgx
TEE_ATTESTATION_URL=

# JWT
JWT_SECRET=
JWT_EXPIRY=3600

# Webhook
WEBHOOK_RETRY_MAX=5
WEBHOOK_RETRY_BACKOFF=exponential

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=kyc-vault

# Admin
ADMIN_API_KEY=
ADMIN_EMAIL=admin@example.com
